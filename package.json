{
  "name": "@local/workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "我的定制工作台 —— 嵌在 DeepSeek Harness 界面里的多场景工作台（角色卡片目录 / 派单闭环 / 权限分档 / 体检）",
  "main": "backend/index.js",
  "exports": {
    ".": "./backend/index.js",
    "./client": "./frontend/client.js",
    "./locale/*.json": "./frontend/locale/*.json",
    "./icon": "./frontend/icon.svg"
  },
  "files": [
    "backend/index.js",
    "frontend/client.js",
    "cordis.patch.yml",
    "frontend/locale/*.json",
    "frontend/icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "start": "node backend/server.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
